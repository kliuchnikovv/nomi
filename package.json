{
  "name": "genie-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Genie AI Assistant Monorepo",
  "workspaces": [
    "front",
    "plugins/*",
    "packages/*"
  ],
  "scripts": {
    "front": "yarn workspace genie",
    "gmail": "yarn workspace @genie/plugin-gmail",
    "calendar": "yarn workspace @genie/plugin-calendar",
    "postinstall": "node scripts/fix-whisper-exports.js && patch-package",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "resolutions": {
    "react-native": "0.81.5",
    "@react-native/assets-registry": "0.81.5",
    "@react-native/normalize-colors": "0.81.5",
    "@react-native/virtualized-lists": "0.81.5",
    "@react-native/js-polyfills": "0.81.5",
    "@react-native/codegen": "0.81.5"
  },
  "overrides": {
    "react-native": "0.81.5",
    "@react-native/assets-registry": "0.81.5",
    "@react-native/normalize-colors": "0.81.5",
    "@react-native/virtualized-lists": "0.81.5",
    "@react-native/js-polyfills": "0.81.5",
    "@react-native/codegen": "0.81.5"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0"
  }
}
