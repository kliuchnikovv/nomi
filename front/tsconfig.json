{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "react-native-gifted-chat": ["src/types/gifted-chat-shim.d.ts"],
      "react-native-gifted-chat/*": ["src/types/gifted-chat-shim.d.ts"],
      "@nomi/front/*": ["src/*"],
      "@nomi/ds": ["../packages/ds/src"],
      "@nomi/ds/*": ["../packages/ds/src/*"],
      "@nomi/plugin-gmail": ["../plugins/gmail"],
      "@nomi/plugin-gmail/*": ["../plugins/gmail/*"],
      "@nomi/plugin-calendar": ["../plugins/calendar"],
      "@nomi/plugin-calendar/*": ["../plugins/calendar/*"],
      "@nomi/plugin-github": ["../plugins/github"],
      "@nomi/plugin-github/*": ["../plugins/github/*"],
      "@nomi/plugin-telegram": ["../plugins/telegram"],
      "@nomi/plugin-telegram/*": ["../plugins/telegram/*"],
      "@nomi/plugin-ios_calendar": ["../plugins/ios_calendar"],
      "@nomi/plugin-ios_calendar/*": ["../plugins/ios_calendar/*"],
      "@nomi/plugin-ios_reminders": ["../plugins/ios_reminders"],
      "@nomi/plugin-ios_reminders/*": ["../plugins/ios_reminders/*"],
      "@nomi/plugin-ios_contacts": ["../plugins/ios_contacts"],
      "@nomi/plugin-ios_contacts/*": ["../plugins/ios_contacts/*"],
      "@nomi/plugin-ios_health": ["../plugins/ios_health"],
      "@nomi/plugin-ios_health/*": ["../plugins/ios_health/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "../plugins"]
}
