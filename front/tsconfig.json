{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "react-native-gifted-chat": ["src/types/gifted-chat-shim.d.ts"],
      "react-native-gifted-chat/*": ["src/types/gifted-chat-shim.d.ts"],
      "@genie/front/*": ["src/*"],
      "@genie/plugin-gmail": ["../plugins/gmail/client/executor.ts"],
      "@genie/plugin-gmail/*": ["../plugins/gmail/client/*"],
      "@genie/plugin-calendar": ["../plugins/calendar/client/executor.ts"],
      "@genie/plugin-calendar/*": ["../plugins/calendar/client/*"],
      "@genie/plugin-github": ["../plugins/github/client/executor.ts"],
      "@genie/plugin-github/*": ["../plugins/github/client/*"],
      "@genie/plugin-telegram": ["../plugins/telegram/client/executor.ts"],
      "@genie/plugin-telegram/*": ["../plugins/telegram/client/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "../plugins"]
}
