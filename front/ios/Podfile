# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => :static#linkage.to_sym
end

target 'genie' do
  use_expo_modules!
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    installer.pods_project.targets.each do |target|
      # Remove ReactCodegen script phase if it causes issues (assuming files are generated manually or by pre-build)
      if target.name == 'ReactCodegen'
        target.build_phases.dup.each do |phase|
          if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
            phase_name = phase.name || phase.display_name || ''
            if phase_name.include?('Generate Specs') || phase_name.include?('[CP-User]')
              Pod::UI.puts "Removing ReactCodegen script phase: #{phase_name}"
              phase.remove_from_project
            end
          end
        end
      end

      # Ослабляем строгие warning-флаги для самых шумных Pod-таргетов
      if ['Yoga', 'SocketRocket', 'glog', 'fmt'].include?(target.name)
        target.build_configurations.each do |config|
          flags = config.build_settings['OTHER_CPLUSPLUSFLAGS']

          # Приводим к строке с пробелами, убираем -Werror и глушим -Wc99-extensions
          if flags.nil? || flags == ['$(inherited)']
            flags = '$(inherited)'
          elsif flags.is_a?(Array)
            flags = flags.join(' ')
          end

          flags = flags.gsub('-Werror', '')
          flags += ' -Wno-error -Wno-c99-extensions'

          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = flags
        end
      end

      target.build_configurations.each do |config|
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'

        # Suppress non-modular include errors (C / C++)
        cflags = config.build_settings['OTHER_CFLAGS']
        if cflags.nil? || cflags == ['$(inherited)']
          cflags = '$(inherited)'
        elsif cflags.is_a?(Array)
          cflags = cflags.join(' ')
        end
        unless cflags.include?('-Wno-error=non-modular-include-in-framework-module')
          cflags += ' -Wno-error=non-modular-include-in-framework-module'
        end
        config.build_settings['OTHER_CFLAGS'] = cflags

        cppflags = config.build_settings['OTHER_CPLUSPLUSFLAGS']
        if cppflags.nil? || cppflags == ['$(inherited)']
          cppflags = '$(inherited)'
        elsif cppflags.is_a?(Array)
          cppflags = cppflags.join(' ')
        end
        unless cppflags.include?('-Wno-error=non-modular-include-in-framework-module')
          cppflags += ' -Wno-error=non-modular-include-in-framework-module'
        end
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = cppflags

        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        unless config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'].include?('HAVE_GOOGLE_SIGNIN=1')
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'HAVE_GOOGLE_SIGNIN=1'
        end
      end
    end
  end
end
