# Railway Sandboxes credentials (required)
RAILWAY_API_TOKEN=
RAILWAY_ENVIRONMENT_ID=
# Optional GraphQL endpoint override (defaults to Railway's prod endpoint)
# RAILWAY_GRAPHQL_ENDPOINT=https://backboard.railway.com/graphql/v2

# Shared secret — must match the plugin's SANDBOX_CONTROLLER_TOKEN
SANDBOX_CONTROLLER_TOKEN=dev-token

# How long an idle Railway sandbox lives before auto-destroy (Pro allows up to 120)
SANDBOX_IDLE_TIMEOUT_MINUTES=30

# Server-side reaper (backstop for sandboxes a leftover process keeps "active",
# so Railway's idle timeout never fires).
# - Reap after this many minutes with no sidecar request to the sandbox.
SANDBOX_REAP_IDLE_MINUTES=20
# - Hard cap: reap any sandbox older than this regardless of activity.
SANDBOX_MAX_AGE_MINUTES=180
# - How often the reaper runs (milliseconds).
SANDBOX_REAP_INTERVAL_MS=300000

# Workspace continuity: checkpoint a sandbox's disk before the reaper destroys
# it, and boot from that checkpoint on the next get-or-create (per user/project).
# Set to 0 to disable (e.g. to avoid checkpoint storage cost).
SANDBOX_CHECKPOINTS=1

PORT=8090
