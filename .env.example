# --- Google OAuth: per-app clients (separate Google Cloud projects) ---
# Gmail plugin (server-side) — "Nomi Gmail" project, Web OAuth client
GOOGLE_GMAIL_CLIENT_ID=your_gmail_oauth_client_id_here
GOOGLE_GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret_here
# Calendar plugin (server-side) — "Nomi Calendar" project, Web OAuth client
GOOGLE_CALENDAR_CLIENT_ID=your_calendar_oauth_client_id_here
GOOGLE_CALENDAR_CLIENT_SECRET=your_calendar_oauth_client_secret_here
# Legacy combined Google client (optional; unused once split above is configured)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AES-256 key (64 hex chars) used to encrypt stored OAuth tokens
ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# --- Gemini API keys (free-tier rotation) ---
# Comma-separated list of keys from each Google Cloud project. The backend
# rotates to the next key on quota exhaustion (HTTP 429 / RESOURCE_EXHAUSTED).
# Falls back to a single GEMINI_API_KEY / GOOGLE_API_KEY if unset.
GEMINI_API_KEYS=key_from_login_project,key_from_gmail_project,key_from_calendar_project

# --- Maps / routing ---
ORS_API_KEY=your_openrouteservice_api_key_here
